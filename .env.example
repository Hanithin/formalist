# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Gemini AI API key
GEMINI_API_KEY=

# Compte administrateur : l'inscription faite avec cette adresse obtient le role admin
ADMIN_EMAIL=

# Emails transactionnels (confirmation d'adresse) - https://resend.com
# Sans RESEND_API_KEY, les emails ne partent pas : le lien s'affiche dans les logs serveur
RESEND_API_KEY=
MAIL_FROM=Formalist <contact@formalist.fr>

# Base des liens envoyes par email
APP_URL=http://localhost:3000

# INPI RNE (capital social des actionnaires personne morale)
# Compte gratuit sur https://www.inpi.fr/ (Espace data / data.inpi.fr)
INPI_USERNAME=
INPI_PASSWORD=

# Guichet unique des formalites d'entreprises - depot des formalites.
#
# Rien a voir avec le RNE ci-dessus : autre portail, autre compte, autre hote. Le
# compte s'ouvre sur https://procedures-demo.inpi.fr (demonstration) ou
# https://procedures.inpi.fr (production), et les deux ne partagent aucun identifiant.
#
# Une premiere connexion par l'interface web est necessaire pour valider les conditions
# particulieres d'utilisation : sans elle, l'API refuse la connexion.
#
# GUICHET_HOTE non renseigne = demonstration. Une configuration incomplete ne doit
# jamais deposer en production.
GUICHET_HOTE=
GUICHET_USERNAME=
GUICHET_PASSWORD=
