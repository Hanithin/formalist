# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Gemini AI API key
GEMINI_API_KEY=

# Compte administrateur : l'inscription faite avec cette adresse obtient le role admin
ADMIN_EMAIL=

# Emails transactionnels (confirmation d'adresse) - https://resend.com
# Sans RESEND_API_KEY, les emails ne partent pas : le lien s'affiche dans les logs serveur
RESEND_API_KEY=
MAIL_FROM=Formalist <contact@formalist.fr>

# Base des liens envoyes par email
APP_URL=http://localhost:3000

# INPI RNE (capital social des actionnaires personne morale)
# Compte gratuit sur https://www.inpi.fr/ (Espace data / data.inpi.fr)
INPI_USERNAME=
INPI_PASSWORD=
